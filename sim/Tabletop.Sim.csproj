<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Tabletop.Sim</RootNamespace>
    <AssemblyName>Tabletop.Sim</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The lifecycle suite's army: management's Army Forge fixture, one file for both. -->
    <EmbeddedResource Include="../tests/Tabletop.Management.Tests/Fixtures/army-forge-c2-6YsWRH3py.json" LogicalName="lifecycle-army-forge-list.json" />
    <!-- The other books' lists, cut from the official books. -->
    <EmbeddedResource Include="Lifecycle/Armies/*.json" LogicalName="lifecycle-army-%(Filename).json" />
    <!-- The 3.6 cut of a book, for the 3.6 shape. -->
    <EmbeddedResource Include="Lifecycle/Armies/3.6/*.json" LogicalName="lifecycle-army-3.6-%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../server/game/Tabletop.GameServer.csproj" />
  </ItemGroup>
</Project>
