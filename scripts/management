#!/usr/bin/env bash
# Run the management API from WSL in dev mode. Reads .env (docker compose's file) for Postgres, MinIO and Stytch settings;
# the Stytch secret comes from `dotnet user-secrets` (server/management) or TABLETOP_STYTCH_SECRET.
# Dev mode (Development plus TABLETOP_DEV_MODE=1) maps POST /v1/dev/sessions, which the simulator's socket driver calls for
# its tokens, and migrates at startup. Development without TABLETOP_DEV_MODE=1 refuses to start.
set -euo pipefail
export ASPNETCORE_ENVIRONMENT="${ASPNETCORE_ENVIRONMENT:-Development}"
export TABLETOP_DEV_MODE="${TABLETOP_DEV_MODE:-1}"
cd "$(dirname "$0")/.."
exec dotnet run --project server/management/Tabletop.Management.csproj "$@"
