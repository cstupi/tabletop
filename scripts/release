#!/usr/bin/env bash
# Cut a release from a clone on the server host (or any machine with the tools): check, test, publish the client builds,
# build and install the web app and the viewer (/viewer/), deploy the servers, publish the built-in content. The client steps are scripts/release-client, which the GitHub release
# workflow runs too. Spec: docs/superpowers/specs/2026-10-17-client-releases-design.md; operator guide: deploy/README.md.
#
#   scripts/release [--version vX.Y.Z] [--deploy docker|home|systemd|none] [--env-file PATH] [--skip-client] [--skip-builtin]
#                   [--tests] [--dry-run]
#
# --version     the tag to release; default the v*.*.* tag on HEAD. The script fetches origin's tags and runs the tag's own
#               copy of itself from a clean worktree of the tag (build/source), so the clone's checkout and local
#               changes never reach a release.
# --deploy      docker (default): deploy/docker-compose.prod.yml up --build; systemd: publish to TABLETOP_INSTALL_DIR
#               (default /opt/tabletop) and restart the units; home: deploy/docker-compose.home.yml, every build and test
#               in containers (no host .NET or Node), the web app as an image; none: build and publish only.
# --env-file    the settings, KEY=VALUE lines; the environment wins over the file. Default /etc/tabletop/prod.env; for home,
#               home.env in the clone if present, else /etc/tabletop/home.env.
# --skip-client no client export or upload: on the host with Godot, else (and always for home) in the builder container.
# --skip-builtin no built-in content publish (scripts/release-client builtin: the terrain catalog, meshes and textures to
#               builtin/ in the blob store, which clients fetch when its version changes; spec
#               docs/superpowers/specs/2026-10-18-builtin-content-from-server-design.md). It runs after the deploy, with the
#               client's upload credentials, on the host with aws and jq or else (and always for home) in the builder container.
# --tests       also build and run the unit suite, the rules suite, check-client and the web and viewer checks. Off by
#               default: CI (.github/workflows/ci.yml) tests every push to main before it is tagged. --skip-tests is accepted
#               and does nothing.  --dry-run  print what would change.
#
# Settings read: TABLETOP_WEB_URL (the client's web origin), TABLETOP_S3_PUBLIC_ENDPOINT (the web build's blob origin),
# TABLETOP_WEB_ROOT (where the static site goes; required to deploy), RELEASE_S3_* and RELEASE_S3_NETWORK (scripts/release-client;
# home defaults: endpoint http://tabletop-s3:9000 on network tabletop-home_backend, bucket TABLETOP_S3_BUCKET),
# GODOT, TABLETOP_INSTALL_DIR, TABLETOP_RELEASE_OUT (the build output, default build/release/<version>).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

version="" deploy=docker env_file="" skip_client=0 skip_builtin=0 skip_tests=1 dry=0
die() { echo "release: $*" >&2; exit 1; }
step() { printf '\n== %s\n' "$*"; }
run() { if [[ $dry == 1 ]]; then printf '+'; printf ' %q' "$@"; printf '\n'; else "$@"; fi; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found${2:+: $2}"; }

args=("$@")
while [[ $# -gt 0 ]]; do
  case "$1" in
    --version) version=${2:?--version needs a value}; shift 2 ;;
    --deploy) deploy=${2:?--deploy needs docker, home, systemd or none}; shift 2 ;;
    --env-file) env_file=${2:?--env-file needs a path}; shift 2 ;;
    --skip-client) skip_client=1; shift ;;
    --skip-builtin) skip_builtin=1; shift ;;
    --tests) skip_tests=0; shift ;;
    --skip-tests) skip_tests=1; shift ;;
    --dry-run) dry=1; shift ;;
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option $1 (see --help)" ;;
  esac
done
[[ $deploy =~ ^(docker|home|systemd|none)$ ]] || die "--deploy is docker, home, systemd or none, not '$deploy'"

# Build from the tag, never from the checkout: fetch origin's tags, put the tag in its own worktree and run that copy of this
# script there (TABLETOP_RELEASE_SOURCE marks the copy). Git runs as the clone's owner, so the worktree stays theirs if run as root.
if [[ -z "${TABLETOP_RELEASE_SOURCE:-}" ]]; then
  owner_uid=$(stat -c %u "$root")
  as_owner() { if [[ $EUID == 0 && $owner_uid != 0 ]]; then sudo -u "#$owner_uid" -H "$@"; else "$@"; fi; }
  as_owner git -C "$root" fetch --tags --force origin || die "cannot fetch tags from origin"
  if [[ -z "$version" ]]; then
    version=$(as_owner git -C "$root" tag --points-at HEAD --list 'v*.*.*' | sort -V | tail -1)
    [[ -n "$version" ]] || die "HEAD carries no v*.*.* tag; pass --version vX.Y.Z"
  fi
  version=v${version#v}
  tagged=$(as_owner git -C "$root" rev-parse -q --verify "refs/tags/$version^{commit}" || true)
  [[ -n "$tagged" ]] || die "no tag $version on origin"
  # One worktree, reused: a new tag is checked out over it and everything but its build/ (the NuGet cache) is cleaned away.
  src=$root/build/source
  if [[ -e "$src/.git" ]]; then
    as_owner git -C "$src" checkout -q --detach --force "$tagged" && as_owner git -C "$src" clean -q -ffdx -e /build/ \
      || die "cannot check out $version in $src"
  else
    rm -rf "$src"; as_owner git -C "$root" worktree prune
    as_owner git -C "$root" worktree add -q --detach "$src" "$tagged" || die "cannot check out $version into $src"
  fi
  # The settings stay the clone's: home.env is not in the tag.
  pass=("${args[@]}")
  if [[ -z "$env_file" ]]; then
    if [[ $deploy == home ]]; then env_file=/etc/tabletop/home.env; [[ -f "$root/home.env" ]] && env_file=$root/home.env
    else env_file=/etc/tabletop/prod.env; fi
    pass+=(--env-file "$env_file")
  fi
  [[ " ${args[*]} " == *" --version "* ]] || pass+=(--version "$version")
  echo "release: $version (${tagged:0:12}) from $src"
  export TABLETOP_RELEASE_SOURCE=1 TABLETOP_RELEASE_OUT=${TABLETOP_RELEASE_OUT:-$root/build/release/${version#v}}
  exec "$src/scripts/release" "${pass[@]}"
fi
if [[ -z "$env_file" ]]; then
  if [[ $deploy == home ]]; then
    env_file=/etc/tabletop/home.env; [[ -f "$root/home.env" ]] && env_file=$root/home.env
  else env_file=/etc/tabletop/prod.env; fi
fi

# Settings: KEY=VALUE lines, read rather than sourced; a variable already in the environment wins. A value is read the way
# compose's --env-file reads it, since what this exports overrides compose's own parse: one pair of matching surrounding
# double or single quotes is removed (KEY="x" is x), an unquoted value is trimmed.
env_value() {   # <raw value> -> the value
  local v=$1
  if [[ $v =~ ^\"(.*)\"[[:space:]]*$ || $v =~ ^\'(.*)\'[[:space:]]*$ ]]; then printf '%s' "${BASH_REMATCH[1]}"
  else v=${v#"${v%%[![:space:]]*}"}; printf '%s' "${v%"${v##*[![:space:]]}"}"; fi
}
# Self-check of the parse; a wrong secret only surfaces as a server refusing it.
env_raw=('"secret-live-1"' "'x y'" 'plain' ' padded ' '""' '' '"a=b"' '"mixed'"'" '"in"side"')
env_want=('secret-live-1'  'x y'   'plain' 'padded'   ''   '' 'a=b'   '"mixed'"'" 'in"side')
for i in "${!env_raw[@]}"; do
  [[ "$(env_value "${env_raw[i]}")" == "${env_want[i]}" ]] \
    || die "env file parse self-check: [${env_raw[i]}] gave [$(env_value "${env_raw[i]}")], not [${env_want[i]}]"
done
if [[ -f "$env_file" ]]; then
  [[ -r "$env_file" ]] || die "$env_file is not readable (run as its owner, or with sudo -E)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]} value=$(env_value "${BASH_REMATCH[2]}")
    [[ -n "${!key+x}" ]] || export "$key=$value"
  done < "$env_file"
elif [[ $deploy == docker || $deploy == home ]]; then die "$env_file not found (--env-file); the $deploy deploy reads it"
else echo "release: no $env_file; using the environment"; fi

step "Preflight"
# A deploy needs every secret its compose file requires; an empty one otherwise surfaces only as a server failing to start.
if [[ $deploy == docker || $deploy == home ]]; then
  for key in TABLETOP_STYTCH_PROJECT_ID TABLETOP_STYTCH_SECRET TABLETOP_DB_OWNER_PASSWORD TABLETOP_DB_MANAGEMENT_PASSWORD \
             TABLETOP_DB_GAME_PASSWORD TABLETOP_S3_ACCESS_KEY TABLETOP_S3_SECRET_KEY TABLETOP_WEB_URL TABLETOP_S3_PUBLIC_ENDPOINT; do
    [[ -n "${!key:-}" ]] || die "$key is empty in $env_file"
  done
fi
need git
if [[ $deploy == home ]]; then need docker
else
  [[ $skip_tests == 1 ]] || need dotnet "install the .NET 10 SDK (global.json)"
  need node "install Node 24"; need npm
fi
# The client: on the host with Godot, else (and always for home) in the builder container (scripts/release-client).
client_args=()
if [[ $deploy == home ]]; then
  # The home stack's MinIO, from a container on its internal backend network; the bucket is the servers' bucket.
  export RELEASE_S3_ENDPOINT=${RELEASE_S3_ENDPOINT:-http://tabletop-s3:9000}
  export RELEASE_S3_BUCKET=${RELEASE_S3_BUCKET:-${TABLETOP_S3_BUCKET:-tabletop-blobs}}
  if [[ -z "${RELEASE_S3_NETWORK:-}" && $RELEASE_S3_ENDPOINT == http://tabletop-s3:9000* ]]; then export RELEASE_S3_NETWORK=tabletop-home_backend; fi
fi
if [[ $skip_client == 0 ]]; then
  for key in TABLETOP_WEB_URL RELEASE_S3_ENDPOINT RELEASE_S3_BUCKET RELEASE_S3_ACCESS_KEY RELEASE_S3_SECRET_KEY; do
    [[ -n "${!key:-}" ]] || die "$key is empty (the client upload needs it; or pass --skip-client)"
  done
  if [[ $deploy == home ]] || ! command -v "${GODOT:-godot}" >/dev/null 2>&1; then
    client_args=(--in-container); need docker "the client builds in a container without Godot on the host"
  else
    need dotnet "install the .NET 10 SDK (global.json)"; need aws "install the AWS CLI v2"; need zip; need jq; need sha256sum; need unzip
  fi
fi
builtin_args=()
if [[ $skip_builtin == 0 ]]; then
  for key in RELEASE_S3_ENDPOINT RELEASE_S3_BUCKET RELEASE_S3_ACCESS_KEY RELEASE_S3_SECRET_KEY; do
    [[ -n "${!key:-}" ]] || die "$key is empty (the built-in content upload needs it; or pass --skip-builtin)"
  done
  if [[ $deploy == home ]]; then builtin_args=(--in-container); need docker; fi
fi
case $deploy in
  docker) need docker; need curl ;;
  systemd) need dotnet; need systemctl; need rsync; need curl ;;
esac
[[ $deploy == none || $deploy == home || -n "${TABLETOP_WEB_ROOT:-}" ]] || die "TABLETOP_WEB_ROOT is not set (the directory the reverse proxy serves the web app from)"
[[ -z "${TABLETOP_WEB_ROOT:-}" ]] || need rsync

porcelain=$(git status --porcelain); [[ -z "$porcelain" ]] || die "the working tree is not clean; commit or stash first"
head=$(git rev-parse HEAD)
if [[ -z "$version" ]]; then
  version=$(git tag --points-at HEAD --list 'v*.*.*' | sort -V | tail -1)
  [[ -n "$version" ]] || die "HEAD carries no v*.*.* tag; tag it (git tag -a vX.Y.Z -m notes) or pass --version"
fi
version=${version#v}
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "version '$version' is not X.Y.Z"
tagged=$(git rev-parse -q --verify "refs/tags/v$version^{commit}" || true)
[[ -n "$tagged" ]] || die "no tag v$version"
[[ "$tagged" == "$head" ]] || die "v$version names $tagged, not HEAD ($head); check out the tag"
out=${TABLETOP_RELEASE_OUT:-$root/build/release/$version}
echo "release v$version at ${head:0:12}, deploy $deploy, output $out"

# home: the SDK and Node images run the same steps over the clone, as the clone's owner; the NuGet cache stays in build/.
owner=$(stat -c %u:%g "$root")
in_sdk() { run docker run --rm -u "$owner" -v "$root:/src" -w /src -e HOME=/tmp -e DOTNET_CLI_TELEMETRY_OPTOUT=1 \
  -e NUGET_PACKAGES=/src/build/nuget mcr.microsoft.com/dotnet/sdk:10.0 "$@"; }
# in_node DIR CMD...: CMD in the Node image in the clone's DIR (web or viewer), the whole clone mounted: the viewer reads
# web/src (Icon.svelte, the themes) and client/content/builtin/catalog.json.
in_node() { local dir=$1; shift
  run docker run --rm -u "$owner" -v "$root:/src" -w "/src/$dir" -e HOME=/tmp -e npm_config_cache=/tmp/npm node:24-alpine "$@"; }

if [[ $skip_tests == 0 ]]; then
  step "Build and test"
  if [[ $deploy == home ]]; then
    in_sdk dotnet build
    in_sdk dotnet test --no-build
    in_sdk dotnet run --no-build --project sim -- suite
  else
    run dotnet build
    run dotnet test
    run dotnet run --project sim -- suite
  fi
  run ./scripts/check-client
fi

if [[ $deploy == home ]]; then
  if [[ $skip_tests == 0 ]]; then
    step "Web app and viewer checks (the builds are in web/Dockerfile)"
    in_sdk ./scripts/geometry-wasm   # the viewer's tests load the runtime from public/geometry/; the image build has its own stage
    for dir in web viewer; do
      in_node "$dir" npm ci --no-audit --no-fund; in_node "$dir" npm run check; in_node "$dir" npm test
    done
  fi
else
step "Web app and viewer"
run npm --prefix web ci --no-audit --no-fund
run ./scripts/geometry-wasm
run npm --prefix viewer ci --no-audit --no-fund
if [[ $skip_tests == 0 ]]; then
  run npm --prefix web run check; run npm --prefix web test
  run npm --prefix viewer run check; run npm --prefix viewer test
fi
blob_origin=""
if [[ -n "${TABLETOP_S3_PUBLIC_ENDPOINT:-}" ]]; then blob_origin=$(sed -E 's#^([a-z]+://[^/]+).*#\1#' <<< "$TABLETOP_S3_PUBLIC_ENDPOINT"); fi
[[ $deploy == none || -n "$blob_origin" ]] || die "TABLETOP_S3_PUBLIC_ENDPOINT is not set (the web build's CSP names the blob origin)"
run env ${blob_origin:+TABLETOP_BLOB_ORIGIN="$blob_origin"} npm --prefix web run build
run npm --prefix viewer run build:hosted
if [[ -n "${TABLETOP_WEB_ROOT:-}" ]]; then
  # The viewer's hosted build (admin Replays) goes under /viewer/ beside the web app.
  run mkdir -p "$TABLETOP_WEB_ROOT/viewer"
  run rsync -a --delete --exclude /viewer/ "$root/web/build/" "$TABLETOP_WEB_ROOT/"
  run rsync -a --delete "$root/viewer/dist/" "$TABLETOP_WEB_ROOT/viewer/"
else echo "TABLETOP_WEB_ROOT unset: web/build and viewer/dist are built, not installed"; fi
fi

if [[ $skip_client == 0 ]]; then
  step "Client builds"
  run mkdir -p "$out"
  # home: the upload waits for the deploy, which starts MinIO and creates the release publisher (minio-init).
  if [[ $deploy == home ]]; then DRY_RUN=$dry "$root/scripts/release-client" "${client_args[@]}" build "$version" "$out"
  else DRY_RUN=$dry "$root/scripts/release-client" "${client_args[@]}" all "$version" "$out"; fi
fi

healthy() {   # <name> <url>: up to 120 s
  [[ $dry == 1 ]] && { echo "+ wait for $2"; return; }
  for _ in $(seq 120); do curl -fsS -m 2 "$2" >/dev/null 2>&1 && { echo "$1 healthy"; return; }; sleep 1; done
  die "$1 did not answer $2 within 120 s"
}

container_state() {   # <container>: status, health (- when it has no healthcheck), exit code
  docker inspect -f '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}} {{.State.ExitCode}}' "$1" 2>/dev/null \
    || echo "missing - -"
}
await() {   # <container> healthy|done: up to 180 s; done is a one-shot that exited 0
  [[ $dry == 1 ]] && { echo "+ wait for $1 $2"; return; }
  local status health code
  for _ in $(seq 90); do
    read -r status health code <<< "$(container_state "$1")"
    case $2 in
      healthy) [[ $health == healthy ]] && { echo "$1 healthy"; return; }
               [[ $status == exited || $status == dead ]] && break ;;
      done) if [[ $status == exited ]]; then [[ $code == 0 ]] && { echo "$1 done"; return; }; break; fi ;;
    esac
    sleep 2
  done
  docker logs --tail 40 "$1" >&2 || true
  die "$1 is not $2 ($(container_state "$1"))"
}

case $deploy in
  home)
    step "Deploy (home)"
    compose=(docker compose --env-file "$env_file" -f deploy/docker-compose.home.yml)
    gateway=${TABLETOP_GATEWAY_NETWORK:-gateway_default}
    docker network inspect "$gateway" >/dev/null 2>&1 || die "docker network $gateway not found (the reverse proxy's network)"
    if [[ -z "${TABLETOP_TRUSTED_PROXIES:-}" ]]; then
      TABLETOP_TRUSTED_PROXIES=$(docker network inspect "$gateway" -f '{{range .IPAM.Config}}{{.Subnet}},{{end}}')
      export TABLETOP_TRUSTED_PROXIES=${TABLETOP_TRUSTED_PROXIES%,}
      [[ -n "$TABLETOP_TRUSTED_PROXIES" ]] || die "network $gateway has no subnet; set TABLETOP_TRUSTED_PROXIES"
    fi
    echo "trusted proxies: $TABLETOP_TRUSTED_PROXIES ($gateway)"
    # Docker would create a missing bind source on the local disk: the NAS must be mounted first.
    for d in "${TABLETOP_MINIO_DATA:-/mnt/tabletop/minio}" "${TABLETOP_PG_BACKUP_DIR:-/mnt/tabletop/pg-backups}"; do
      [[ -d "$d" ]] || die "$d does not exist (is the NAS mounted?)"
    done
    export TABLETOP_VERSION="$version"
    run "${compose[@]}" build
    # depends_on orders the start: postgres healthy, migrate (the owner role) exits 0, minio healthy, minio-init exits 0,
    # management healthy, then game. up fails when migrate or minio-init fails.
    run "${compose[@]}" up -d --no-build --remove-orphans
    prefix=${TABLETOP_CONTAINER_PREFIX:-tabletop}
    await "$prefix-migrate" "done"
    await "$prefix-minio-init" "done"
    for c in postgres minio management game web; do await "$prefix-$c" healthy; done
    run "${compose[@]}" ps
    if [[ $skip_client == 0 ]]; then
      step "Client upload (${RELEASE_S3_ENDPOINT}${RELEASE_S3_NETWORK:+, network $RELEASE_S3_NETWORK})"
      DRY_RUN=$dry "$root/scripts/release-client" "${client_args[@]}" upload "$version" "$out"
    fi ;;
  docker)
    step "Deploy (docker)"
    # migrate runs first on every up; management starts after it exits 0, game after management is healthy.
    run env TABLETOP_VERSION="$version" docker compose --env-file "$env_file" -f deploy/docker-compose.prod.yml up -d --build
    healthy management http://127.0.0.1:5100/healthz
    healthy game http://127.0.0.1:5200/healthz ;;
  systemd)
    step "Deploy (systemd)"
    install_dir=${TABLETOP_INSTALL_DIR:-/opt/tabletop}
    stage=$(mktemp -d); trap 'rm -rf "$stage"' EXIT
    run dotnet publish server/management -c Release -o "$stage/management"
    run dotnet publish server/game -c Release -o "$stage/game"
    run systemctl stop tabletop-game tabletop-management
    run rsync -a --delete "$stage/management/" "$install_dir/management/"
    run rsync -a --delete "$stage/game/" "$install_dir/game/"
    run systemctl restart tabletop-migrate        # Tabletop.Management --migrate as the owner role (/etc/tabletop/migrate.env)
    run systemctl start tabletop-management tabletop-game
    healthy management http://127.0.0.1:5100/healthz
    healthy game http://127.0.0.1:5200/healthz ;;
  none) ;;
esac

if [[ $skip_builtin == 0 ]]; then
  step "Built-in content (${RELEASE_S3_ENDPOINT}${RELEASE_S3_NETWORK:+, network $RELEASE_S3_NETWORK})"
  run mkdir -p "$out"
  DRY_RUN=$dry "$root/scripts/release-client" "${builtin_args[@]}" builtin "$version" "$out"
fi

step "Done"
echo "v$version (${head:0:12})"
[[ $skip_tests == 1 ]] && echo "  tests:   none (CI tests main; --tests runs them here)" || echo "  tests:   build, unit suite, rules suite, check-client, web and viewer checks and tests"
[[ $skip_builtin == 1 ]] && echo "  builtin: skipped" || echo "  builtin: s3://${RELEASE_S3_BUCKET:-?}/builtin/catalog.json, version $version"
[[ $skip_client == 1 ]] && echo "  client:  skipped" || echo "  client:  s3://${RELEASE_S3_BUCKET:-?}/${RELEASE_S3_PREFIX:-releases}/$version/ and latest.json"
if [[ $deploy == home ]]; then echo "  web:     image tabletop-web:$version (viewer under /viewer/)"
else echo "  web:     ${TABLETOP_WEB_ROOT:-web/build (not installed)}"; fi
echo "  servers: $deploy"
[[ $dry == 1 ]] && echo "  (dry run: nothing changed)"
exit 0
