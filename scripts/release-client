#!/usr/bin/env bash
# The client half of a release (spec docs/superpowers/specs/2026-10-17-client-releases-design.md), shared by
# scripts/release and .github/workflows/release.yml.
#
#   scripts/release-client export  <version> <out>   Godot export of the Windows, Linux and macOS presets into <out>/<platform>
#   scripts/release-client notes   <version> <out>   <out>/notes.txt: tag v<version>'s annotation, else its CHANGELOG.md section
#   scripts/release-client package <version> <out>   zips, sizes, SHA-256 and <out>/manifest.json (notes: RELEASE_NOTES_FILE,
#                                                    default <out>/notes.txt)
#   scripts/release-client upload  <version> <out>   the zips, releases/<version>/manifest.json, then releases/latest.json
#   scripts/release-client build   <version> <out>   export, notes, package; nothing when the client is unchanged (below)
#   scripts/release-client all     <version> <out>   build, then upload; nothing when the client is unchanged
#   scripts/release-client unchanged <version> <out> exit 0 and print the published version when releases/latest.json's source is
#                                                    RELEASE_CLIENT_SOURCE (default this commit's), else exit 1
#   scripts/release-client source [<commit>]         the client's source fingerprint at the commit (default HEAD)
#   scripts/release-client builtin <version> <out>   the built-in content (spec 2026-10-18-builtin-content-from-server-design.md):
#                                                    <out>/builtin/catalog.json (client/content/builtin/catalog.json plus version
#                                                    and each file's sha256 and size), each file to builtin/<sha256>, then
#                                                    builtin/catalog.json. BUILTIN_SOURCE names another directory laid out like
#                                                    client/content/builtin (a test publish). Runs in the upload container
#                                                    unless aws, jq and sha256sum are on the host.
#   scripts/release-client --in-container <step> <version> <out>
#
# Container mode (--in-container, or automatically when GODOT/godot is not on PATH): export and package run in the
# builder image (scripts/client-build/Dockerfile, tag tabletop-client-build:<Godot version>, built here and cached), with
# the clone mounted read-only, <out> writable, build/nuget as the NuGet cache, as the clone's owner uid; notes runs on the
# host, which has the tags. upload runs in a second container that gets RELEASE_S3_* from the environment and joins
# RELEASE_S3_NETWORK when set (e.g. tabletop-home_backend, whose MinIO is http://tabletop-s3:9000). The export container
# resolves through TABLETOP_DNS_1/TABLETOP_DNS_2 (default 1.1.1.1, 9.9.9.9) for NuGet. The host needs docker and git only.
#
# Client releases only on client changes (spec docs/superpowers/specs/2026-11-07-assets-on-demand-and-client-releases-design.md):
# the source fingerprint is one SHA-256 over git ls-tree of the client's inputs (client_source); package writes it to the manifest
# as "source". build and all first read the published releases/latest.json (on the host with aws, else in the upload container, so
# the publisher's key stays where RELEASE_S3_* is); when its source is this commit's they print "client unchanged since <version>:
# not published", write <out>/unchanged.txt (the published version) and stop. RELEASE_FORCE_CLIENT=1 publishes anyway; a
# latest.json without source, or one that cannot be read, publishes.
#
# export checks each pack (scripts/pck-files) lacks the built-in terrain meshes and textures (fetched on demand by the client),
# and fails when one is there.
# export needs GODOT (default: godot on PATH, Godot 4.7.2 .NET with its export templates), dotnet, and TABLETOP_WEB_URL (the web
# app's public origin, which the build reaches management and the game socket through). upload needs aws and RELEASE_S3_ENDPOINT,
# RELEASE_S3_BUCKET, RELEASE_S3_ACCESS_KEY, RELEASE_S3_SECRET_KEY; RELEASE_S3_REGION (default us-east-1; R2 takes auto) and
# RELEASE_S3_PREFIX (default releases, which management reads; a test run names another) are optional.
# DRY_RUN=1 prints the commands that change anything instead of running them.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
platforms=(windows linux macos)

die() { echo "release-client: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found${2:+: $2}"; }
run() { if [[ "${DRY_RUN:-}" == 1 ]]; then printf '+'; printf ' %q' "$@"; printf '\n'; else "$@"; fi; }

preset_of() { case "$1" in windows) echo Windows ;; linux) echo Linux ;; macos) echo macOS ;; esac; }
target_of() { case "$1" in windows) echo Tabletop.exe ;; linux) echo Tabletop.x86_64 ;; macos) echo Tabletop.zip ;; esac; }
zip_of() {   # <version> <platform>
  case "$2" in windows) echo "tabletop-$1-windows-x86_64.zip" ;; linux) echo "tabletop-$1-linux-x86_64.zip" ;; macos) echo "tabletop-$1-macos-universal.zip" ;; esac
}

check_version() { [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "version '$1' is not X.Y.Z (the tag without its v)"; }
check_web_url() {
  [[ -n "${TABLETOP_WEB_URL:-}" ]] || die "TABLETOP_WEB_URL is not set (the web app's public origin, e.g. https://tabletop.example.org)"
  [[ "$TABLETOP_WEB_URL" =~ ^https?://[^/]+/?$ ]] || die "TABLETOP_WEB_URL '$TABLETOP_WEB_URL' is not an origin (scheme and host, no path)"
}
check_s3() { local v; for v in RELEASE_S3_ENDPOINT RELEASE_S3_BUCKET RELEASE_S3_ACCESS_KEY RELEASE_S3_SECRET_KEY; do [[ -n "${!v:-}" ]] || die "$v is not set"; done; }

export_builds() {   # <version> <out>
  local version=$1 out=$2 godot=${GODOT:-godot}
  need "$godot" "install Godot 4.7.2 .NET and its export templates, or set GODOT"
  need dotnet
  check_web_url
  local proj=$root
  if [[ -n "${RELEASE_CLIENT_IN_CONTAINER:-}" ]]; then
    # The clone is mounted read-only; Godot's import and the .NET build write into a copy of its files (<out>/.sources).
    proj=/tmp/work; mkdir -p "$proj"
    tar -C "$root" --null -T "$out/.sources" -cf - | tar -C "$proj" -xf -
    # The last release's import (/godot-cache, the host's build/godot-cache): Godot then re-imports only what changed.
    if [[ -d /godot-cache && -n "$(ls -A /godot-cache)" ]]; then mkdir -p "$proj/client/.godot" && cp -a /godot-cache/. "$proj/client/.godot/"; fi
  fi
  # Import first: a fresh clone has no client/.godot, and the export reads the imported resources.
  run "$godot" --headless --path "$proj/client" --import
  if [[ -n "${RELEASE_CLIENT_IN_CONTAINER:-}" && -d /godot-cache && "${DRY_RUN:-}" != 1 ]]; then
    find /godot-cache -mindepth 1 -delete && cp -a "$proj/client/.godot/." /godot-cache/
  fi
  for p in "${platforms[@]}"; do
    run rm -rf "$out/$p"; run mkdir -p "$out/$p"
    run env TabletopVersion="$version" TabletopWebUrl="${TABLETOP_WEB_URL%/}" \
      "$godot" --headless --path "$proj/client" --export-release "$(preset_of "$p")" "$out/$p/$(target_of "$p")"
    [[ "${DRY_RUN:-}" == 1 ]] && continue
    # Godot exits 0 when the .NET step fails and ships a build with no assemblies, so check for them.
    case "$p" in
      # grep reads the whole listing: -q would stop early and fail the pipe (pipefail, SIGPIPE on unzip).
      macos) unzip -l "$out/$p/Tabletop.zip" | grep 'Contents/Resources/data_Tabletop_macos_arm64/Tabletop.dll' >/dev/null \
               || die "the macOS export has no .NET assemblies; see the Godot output above" ;;
      *) compgen -G "$out/$p/data_Tabletop_*/Tabletop.dll" >/dev/null || die "the $p export has no .NET assemblies; see the Godot output above" ;;
    esac
    check_pack "$p" "$out"
  done
}

client_source() {   # [<commit>]: SHA-256 over git ls-tree of the client's inputs; the built-in content and *.md are not inputs
  local commit=${1:-HEAD}
  git -C "$root" rev-parse -q --verify "$commit^{commit}" >/dev/null || die "no commit $commit"
  git -C "$root" -c core.quotepath=off ls-tree -r "$commit" -- client libs/Tabletop.Geometry libs/Tabletop.Content libs/Tabletop.Protocol \
      Directory.Build.props global.json scripts/release-client scripts/client-build \
    | awk -F'\t' '$2 !~ /^client\/content\/builtin\// && $2 !~ /\.md$/' | sha256sum | cut -d' ' -f1
}

published_unchanged() {   # <out>: prints the published version and exits 0 when latest.json's source is RELEASE_CLIENT_SOURCE
  local prefix=${RELEASE_S3_PREFIX:-releases} latest theirs
  need aws "install the AWS CLI v2"; need jq; check_s3
  [[ -n "${RELEASE_CLIENT_SOURCE:-}" ]] || die "RELEASE_CLIENT_SOURCE is not set"
  export AWS_ACCESS_KEY_ID="$RELEASE_S3_ACCESS_KEY" AWS_SECRET_ACCESS_KEY="$RELEASE_S3_SECRET_KEY" AWS_DEFAULT_REGION="${RELEASE_S3_REGION:-us-east-1}"
  export AWS_REQUEST_CHECKSUM_CALCULATION=when_required AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
  latest=$(aws --endpoint-url "$RELEASE_S3_ENDPOINT" s3 cp --only-show-errors "s3://$RELEASE_S3_BUCKET/$prefix/latest.json" - 2>/dev/null) \
    || { echo "release-client: cannot read $prefix/latest.json" >&2; return 1; }
  theirs=$(jq -r '.source // empty' <<< "$latest" 2>/dev/null) || theirs=""
  [[ -n "$theirs" && "$theirs" == "$RELEASE_CLIENT_SOURCE" ]] || return 1
  jq -r '.version' <<< "$latest"
}

client_changed() {   # <out>: 0 to publish; 1 (with <out>/unchanged.txt) when the published client has this source
  local out=$1 published
  rm -f "$out/unchanged.txt"
  if [[ "${RELEASE_FORCE_CLIENT:-}" == 1 ]]; then echo "release-client: RELEASE_FORCE_CLIENT=1: publishing the client"; return 0; fi
  if ! published=$(unchanged_step "$out"); then echo "release-client: no published client with source ${RELEASE_CLIENT_SOURCE:0:12}: publishing"; return 0; fi
  echo "release-client: client unchanged since $published: not published"
  [[ "${DRY_RUN:-}" == 1 ]] || printf '%s\n' "$published" > "$out/unchanged.txt"
  return 1
}

check_pack() {   # <platform> <out>: the export's pack lacks the built-in meshes and textures, which the client fetches on demand
  local p=$1 out=$2 pck listing f name shipped=()
  if [[ $p == macos ]]; then
    pck="$out/macos/Tabletop.pck"
    unzip -p "$out/macos/Tabletop.zip" 'Tabletop.app/Contents/Resources/Tabletop.pck' > "$pck" || die "the macOS export has no Tabletop.pck"
  else pck="$out/$p/Tabletop.pck"; fi
  listing=$("$root/scripts/pck-files" "$pck") || die "cannot read $pck"
  [[ $p == macos ]] && rm -f "$pck"
  # The files themselves, and a texture's import (.godot/imported/<name>.png-<md5 of its res:// path>.*).
  shipped=($(grep -E '^content/builtin/(terrain|textures)/' <<< "$listing" || true))
  for f in "$root"/client/content/builtin/textures/*.png; do
    name=$(basename "$f")
    shipped+=($(grep -F ".godot/imported/$name-$(printf '%s' "res://${f#"$root/client/"}" | md5sum | cut -d' ' -f1)." <<< "$listing" || true))
  done
  (( ${#shipped[@]} == 0 )) || die "the $p export's pack holds built-in content the client fetches on demand: ${shipped[*]}"
  echo "release-client: pack ok: $p ($(wc -l <<< "$listing") files, no built-in meshes or textures)"
}

release_notes() {   # <version> <out>: <out>/notes.txt from the tag's annotation, else CHANGELOG.md's section, else empty
  local version=$1 out=$2 tag="v$1" notes=""
  if [[ "$(git -C "$root" cat-file -t "refs/tags/$tag" 2>/dev/null)" == tag ]]; then
    notes=$(git -C "$root" for-each-ref "refs/tags/$tag" --format='%(contents)' | sed '/^-----BEGIN PGP SIGNATURE-----/,$d')
  fi
  if [[ -z "${notes//[[:space:]]/}" && -f "$root/CHANGELOG.md" ]]; then
    notes=$(awk -v v="$version" '
      /^## / { if (found) exit; h = $0; sub(/^## +\[?v?/, "", h); sub(/[] ].*$/, "", h); if (h == v) { found = 1; next } }
      found { print }' "$root/CHANGELOG.md")
  fi
  [[ "${DRY_RUN:-}" == 1 ]] && { echo "+ write $out/notes.txt"; return; }
  printf '%s\n' "$notes" | sed '/./,$!d' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' > "$out/notes.txt"
}

package_builds() {   # <version> <out>
  local version=$1 out=$2 entries=() p zip size sha notes
  need zip; need sha256sum; need jq
  for p in "${platforms[@]}"; do
    zip=$(zip_of "$version" "$p")
    [[ "${DRY_RUN:-}" == 1 ]] || [[ -d "$out/$p" ]] || die "$out/$p is missing; run export first"
    run rm -f "$out/$zip"
    if [[ "$p" == macos ]]; then
      run cp "$out/$p/Tabletop.zip" "$out/$zip"    # Godot's zip already holds Tabletop.app, signature intact
      # beside the app: the helper that clears the download quarantine from the whole bundle (deploy/README.md → Releases)
      run bash -c 'cd "$1" && zip -q -X "$2" "Open Tabletop.command"' _ "$root/scripts/client-build/macos" "$out/$zip"
      [[ "${DRY_RUN:-}" == 1 ]] || unzip -Z "$out/$zip" 'Open Tabletop.command' | grep -q '^-rwx' \
        || die "the macOS zip lacks an executable Open Tabletop.command"
    else run bash -c 'cd "$1" && zip -qr -X "$2" .' _ "$out/$p" "$out/$zip"; fi
    [[ "${DRY_RUN:-}" == 1 ]] && continue
    size=$(stat -c %s "$out/$zip"); sha=$(sha256sum "$out/$zip" | cut -d' ' -f1)
    entries+=("$(jq -n --arg p "$p" --arg key "${RELEASE_S3_PREFIX:-releases}/$version/$zip" --argjson size "$size" --arg sha "$sha" \
      '{($p): {key: $key, size: $size, sha256: $sha}}')")
  done
  [[ "${DRY_RUN:-}" == 1 ]] && { echo "+ write $out/manifest.json"; return; }
  local notes_file=${RELEASE_NOTES_FILE:-$out/notes.txt}
  notes=""; if [[ -f "$notes_file" ]]; then notes=$(cat "$notes_file"); fi
  local protocol; protocol=$(sed -nE 's/.*const int Current = ([0-9]+);.*/\1/p' "$root/libs/Tabletop.Protocol/ProtocolVersion.cs")
  [[ -n "$protocol" ]] || die "cannot read ProtocolVersion.Current"
  local source=${RELEASE_CLIENT_SOURCE:-}
  [[ -n "$source" ]] || source=$(client_source)
  printf '%s\n' "${entries[@]}" | jq -s --arg v "$version" --arg date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg notes "$notes" --argjson protocol "$protocol" \
    --arg source "$source" '{version: $v, date: $date, notes: $notes, protocolVersion: $protocol, source: $source, platforms: add}' > "$out/manifest.json"
  echo "release-client: $out/manifest.json"; jq -r '.platforms | to_entries[] | "  \(.key)  \(.value.size) bytes  \(.value.sha256)"' "$out/manifest.json"
}

upload_builds() {   # <version> <out>
  local version=$1 out=$2 prefix=${RELEASE_S3_PREFIX:-releases}
  need aws "install the AWS CLI v2"
  check_s3
  [[ "${DRY_RUN:-}" == 1 ]] || [[ -f "$out/manifest.json" ]] || die "$out/manifest.json is missing; run package first"
  export AWS_ACCESS_KEY_ID="$RELEASE_S3_ACCESS_KEY" AWS_SECRET_ACCESS_KEY="$RELEASE_S3_SECRET_KEY" AWS_DEFAULT_REGION="${RELEASE_S3_REGION:-us-east-1}"
  # R2 and MinIO reject the CLI's default CRC checksums on some versions; send them only when the store asks.
  export AWS_REQUEST_CHECKSUM_CALCULATION=when_required AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
  local s3=(aws --endpoint-url "$RELEASE_S3_ENDPOINT" s3 cp --only-show-errors)
  local dest="s3://$RELEASE_S3_BUCKET/$prefix"
  # The zips, then this version's manifest, then latest.json: latest.json never names a missing object.
  for p in "${platforms[@]}"; do run "${s3[@]}" --content-type application/zip "$out/$(zip_of "$version" "$p")" "$dest/$version/$(zip_of "$version" "$p")"; done
  run "${s3[@]}" --content-type application/json "$out/manifest.json" "$dest/$version/manifest.json"
  run "${s3[@]}" --content-type application/json --cache-control no-cache "$out/manifest.json" "$dest/latest.json"
  echo "release-client: published $version to $dest/"
}

builtin_publish() {   # <version> <out>
  local version=$1 out=$2 src=${BUILTIN_SOURCE:-$root/client/content/builtin} files='{}' path sha size type
  need jq; need sha256sum; need aws "install the AWS CLI v2"; check_s3
  [[ -f "$src/catalog.json" ]] || die "$src/catalog.json is missing"
  while IFS= read -r path; do
    [[ -f "$src/$path" ]] || die "$src/$path is missing (the catalog names it)"
    sha=$(sha256sum "$src/$path" | cut -d' ' -f1); size=$(stat -c %s "$src/$path")
    files=$(jq --arg p "$path" --arg sha "$sha" --argjson size "$size" '. + {($p): {sha256: $sha, size: $size}}' <<< "$files")
  done < <(jq -r '(.meshes[] | "terrain/\(.).glb"), (.textures[] | "textures/\(.).png")' "$src/catalog.json")
  mkdir -p "$out/builtin"
  jq --arg v "$version" --argjson files "$files" '{version: $v} + . + {files: $files}' "$src/catalog.json" > "$out/builtin/catalog.json"
  echo "release-client: $out/builtin/catalog.json"; jq -r '.files | to_entries[] | "  \(.key)  \(.value.size) bytes  \(.value.sha256)"' "$out/builtin/catalog.json"
  export AWS_ACCESS_KEY_ID="$RELEASE_S3_ACCESS_KEY" AWS_SECRET_ACCESS_KEY="$RELEASE_S3_SECRET_KEY" AWS_DEFAULT_REGION="${RELEASE_S3_REGION:-us-east-1}"
  export AWS_REQUEST_CHECKSUM_CALCULATION=when_required AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
  local s3=(aws --endpoint-url "$RELEASE_S3_ENDPOINT" s3 cp --only-show-errors) dest="s3://$RELEASE_S3_BUCKET/builtin"
  # The files by content hash (immutable), then the catalog: it never names a missing object.
  while IFS=$'\t' read -r path sha; do
    case $path in *.glb) type=model/gltf-binary ;; *.png) type=image/png ;; *) type=application/octet-stream ;; esac
    run "${s3[@]}" --content-type "$type" --cache-control "public, max-age=31536000, immutable" "$src/$path" "$dest/$sha"
  done < <(jq -r '.files | to_entries[] | "\(.key)\t\(.value.sha256)"' "$out/builtin/catalog.json")
  run "${s3[@]}" --content-type application/json --cache-control no-cache "$out/builtin/catalog.json" "$dest/catalog.json"
  echo "release-client: built-in content $version to $dest/"
}

# Container mode: the same steps in the builder image (header).
image="tabletop-client-build:$(sed -nE 's/^ARG GODOT_VERSION=(.+)$/\1/p' "$root/scripts/client-build/Dockerfile")"
owner=$(stat -c %u:%g "$root")

builder_image() { need docker; run docker build -q -t "$image" "$root/scripts/client-build"; }

owned_dir() {   # <dir>: exists and belongs to the clone's owner, who the containers run as
  [[ -L "$1" ]] && die "$1 is a symlink; refusing to take ownership of its target"
  run mkdir -p "$1"
  [[ -L "$1" ]] && die "$1 is a symlink; refusing to take ownership of its target"
  if [[ $EUID == 0 ]]; then run chown -h "$owner" "$1"; fi
}

container_build() {   # <step: export|package|build> <version> <out>
  local step=$1 version=$2 out=$3
  need git
  [[ $step == package ]] || check_web_url
  if [[ $step == build ]]; then
    if [[ -n "${RELEASE_NOTES_FILE:-}" ]]; then run cp "$RELEASE_NOTES_FILE" "$out/notes.txt"; else release_notes "$version" "$out"; fi
  fi
  builder_image
  owned_dir "$out"; owned_dir "$root/build/nuget"; owned_dir "$root/build/godot-cache"
  # What the export copies out of the read-only clone: tracked and untracked-but-not-ignored files.
  if [[ "${DRY_RUN:-}" == 1 ]]; then echo "+ write $out/.sources (git ls-files)"
  else git -C "$root" ls-files -z --cached --others --exclude-standard > "$out/.sources"; fi
  run docker run --rm -u "$owner" --dns "${TABLETOP_DNS_1:-1.1.1.1}" --dns "${TABLETOP_DNS_2:-9.9.9.9}" \
    -v "$root:/src:ro" -v "$out:/out" -v "$root/build/nuget:/nuget" -e NUGET_PACKAGES=/nuget -v "$root/build/godot-cache:/godot-cache" \
    -e RELEASE_CLIENT_IN_CONTAINER=1 -e TABLETOP_WEB_URL -e RELEASE_S3_PREFIX -e RELEASE_CLIENT_SOURCE \
    "$image" /src/scripts/release-client "$step" "$version" /out
  run rm -f "$out/.sources"
}

container_upload() {   # <version> <out>: the credentials pass by name (-e NAME), never on the command line
  local version=$1 out=$2 net=()
  check_s3
  [[ "${DRY_RUN:-}" == 1 ]] || [[ -f "$out/manifest.json" ]] || die "$out/manifest.json is missing; run package first"
  builder_image
  if [[ -n "${RELEASE_S3_NETWORK:-}" ]]; then net=(--network "$RELEASE_S3_NETWORK")
  else net=(--dns "${TABLETOP_DNS_1:-1.1.1.1}" --dns "${TABLETOP_DNS_2:-9.9.9.9}"); fi
  run docker run --rm -u "$owner" "${net[@]}" -v "$root:/src:ro" -v "$out:/out:ro" -e RELEASE_CLIENT_IN_CONTAINER=1 \
    -e RELEASE_S3_ENDPOINT -e RELEASE_S3_BUCKET -e RELEASE_S3_ACCESS_KEY -e RELEASE_S3_SECRET_KEY -e RELEASE_S3_REGION -e RELEASE_S3_PREFIX \
    "$image" /src/scripts/release-client upload "$version" /out
}

container_unchanged() {   # as container_upload, nothing mounted writable; the published version on stdout
  local net=()
  check_s3
  builder_image >&2
  if [[ -n "${RELEASE_S3_NETWORK:-}" ]]; then net=(--network "$RELEASE_S3_NETWORK")
  else net=(--dns "${TABLETOP_DNS_1:-1.1.1.1}" --dns "${TABLETOP_DNS_2:-9.9.9.9}"); fi
  docker run --rm -u "$owner" "${net[@]}" -v "$root:/src:ro" -e RELEASE_CLIENT_IN_CONTAINER=1 -e RELEASE_CLIENT_SOURCE \
    -e RELEASE_S3_ENDPOINT -e RELEASE_S3_BUCKET -e RELEASE_S3_ACCESS_KEY -e RELEASE_S3_SECRET_KEY -e RELEASE_S3_REGION -e RELEASE_S3_PREFIX \
    "$image" /src/scripts/release-client unchanged 0.0.0 /tmp
}

container_builtin() {   # <version> <out>: as container_upload, the output writable for builtin/catalog.json
  local version=$1 out=$2 net=() src=()
  check_s3
  builder_image
  owned_dir "$out"
  if [[ -n "${RELEASE_S3_NETWORK:-}" ]]; then net=(--network "$RELEASE_S3_NETWORK")
  else net=(--dns "${TABLETOP_DNS_1:-1.1.1.1}" --dns "${TABLETOP_DNS_2:-9.9.9.9}"); fi
  if [[ -n "${BUILTIN_SOURCE:-}" ]]; then src=(-v "$(cd "$BUILTIN_SOURCE" && pwd):/builtin:ro" -e BUILTIN_SOURCE=/builtin); fi
  run docker run --rm -u "$owner" "${net[@]}" -v "$root:/src:ro" -v "$out:/out" "${src[@]}" -e RELEASE_CLIENT_IN_CONTAINER=1 -e DRY_RUN \
    -e RELEASE_S3_ENDPOINT -e RELEASE_S3_BUCKET -e RELEASE_S3_ACCESS_KEY -e RELEASE_S3_SECRET_KEY -e RELEASE_S3_REGION \
    "$image" /src/scripts/release-client builtin "$version" /out
}

container=0
if [[ "${1:-}" == --in-container ]]; then container=1; shift; fi
if [[ "${1:-}" == source ]]; then [[ $# -le 2 ]] || die "usage: scripts/release-client source [<commit>]"; client_source "${2:-HEAD}"; exit 0; fi
if [[ -n "${RELEASE_CLIENT_IN_CONTAINER:-}" ]]; then container=0
elif [[ $container == 0 && "${1:-}" == builtin ]]; then
  for tool in aws jq sha256sum; do command -v $tool >/dev/null 2>&1 || { container=1; echo "release-client: $tool not found; publishing the built-in content from the builder container ($image)"; break; }; done
elif [[ $container == 0 ]] && ! command -v "${GODOT:-godot}" >/dev/null 2>&1; then
  container=1; echo "release-client: ${GODOT:-godot} not found; running in the builder container ($image)"
fi

[[ $# -eq 3 ]] || die "usage: scripts/release-client [--in-container] export|notes|package|build|upload|all|builtin|unchanged <version> <out> | source [<commit>]"
check_version "$2"
mkdir -p "$3"; out="$(cd "$3" && pwd)"
# The published latest.json: read in the upload container in container mode, else here.
unchanged_step() { if [[ $container == 1 ]]; then container_unchanged; else published_unchanged "$1"; fi; }
if [[ -z "${RELEASE_CLIENT_IN_CONTAINER:-}" ]]; then
  # The fingerprint is taken here, where git is; the builder container gets it through the environment.
  case "$1" in package|build|all|unchanged) export RELEASE_CLIENT_SOURCE=${RELEASE_CLIENT_SOURCE:-$(client_source)} ;; esac
  case "$1" in build|all) client_changed "$out" || exit 0 ;; esac
fi
if [[ $container == 1 ]]; then
  case "$1" in
    export|package|build) container_build "$1" "$2" "$out" ;;
    notes) release_notes "$2" "$out" ;;
    upload) container_upload "$2" "$out" ;;
    all) container_build build "$2" "$out"; container_upload "$2" "$out" ;;
    builtin) container_builtin "$2" "$out" ;;
    unchanged) container_unchanged ;;
    *) die "unknown step '$1'" ;;
  esac
  exit 0
fi
case "$1" in
  export) export_builds "$2" "$out" ;;
  notes) release_notes "$2" "$out" ;;
  package) package_builds "$2" "$out" ;;
  upload) upload_builds "$2" "$out" ;;
  # In the builder the host has written notes.txt already.
  build) export_builds "$2" "$out"; [[ -n "${RELEASE_CLIENT_IN_CONTAINER:-}" ]] || release_notes "$2" "$out"; package_builds "$2" "$out" ;;
  all) export_builds "$2" "$out"; release_notes "$2" "$out"; package_builds "$2" "$out"; upload_builds "$2" "$out" ;;
  builtin) builtin_publish "$2" "$out" ;;
  unchanged) published_unchanged "$out" ;;
  *) die "unknown step '$1'" ;;
esac
