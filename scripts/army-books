#!/usr/bin/env bash
# Fetch the official Grimdark Future army books from Army Forge, or generate server/game/Content/<edition folder>/army-books/ from a fetched copy.
# Spell library spec → The generator. `fetch` is the only command that calls Army Forge.
set -euo pipefail
cd "$(dirname "$0")/.."
exec dotnet run --project scripts/ArmyBooks -- "$@"
