#!/usr/bin/env bash
# Run the web app's dev server on the host on :5173, proxying /v1 to TABLETOP_API_PROXY_TARGET (default
# http://localhost:5100). `docker compose up -d` already runs it as the `web` service; `docker compose stop web` first.
# Needs `npm install` once in web/.
set -euo pipefail
cd "$(dirname "$0")/../web"
exec npm run dev -- "$@"
