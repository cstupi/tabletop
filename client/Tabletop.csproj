<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Tabletop</RootNamespace>
  </PropertyGroup>

  <!-- A release build sets TabletopVersion (the tag without its v) and TabletopWebUrl (the web app's public origin), as
       environment variables or -p: properties. BuildInfo reads them back; an unset one leaves a development build. -->
  <PropertyGroup Condition="'$(TabletopVersion)' != ''">
    <Version>$(TabletopVersion)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="TabletopVersion" Value="$(TabletopVersion)" Condition="'$(TabletopVersion)' != ''" />
    <AssemblyMetadata Include="TabletopWebUrl" Value="$(TabletopWebUrl)" Condition="'$(TabletopWebUrl)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <!-- The packed built-in catalog (BuiltinContent.Packed); its meshes and textures ship as res://content/builtin/ files. -->
    <EmbeddedResource Include="content/builtin/catalog.json" LogicalName="builtin-catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\Tabletop.Geometry\Tabletop.Geometry.csproj" />
    <ProjectReference Include="..\libs\Tabletop.Content\Tabletop.Content.csproj" />
    <ProjectReference Include="..\libs\Tabletop.Protocol\Tabletop.Protocol.csproj" />
  </ItemGroup>

</Project>
