[Unit]
Description=Tabletop management API (127.0.0.1:5100, behind the reverse proxy)
After=network-online.target postgresql.service tabletop-migrate.service
Wants=network-online.target
Requires=tabletop-migrate.service

[Service]
Type=exec
# The runtime role's TABLETOP_DB_CONNECTION, the S3 service user, Stytch, TABLETOP_WEB_URL. Mode 0600, owner root.
EnvironmentFile=/etc/tabletop/management.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_EnableDiagnostics=0
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=TABLETOP_MANAGEMENT_URL=http://127.0.0.1:5100
WorkingDirectory=/opt/tabletop/management
ExecStart=/usr/bin/dotnet /opt/tabletop/management/Tabletop.Management.dll
Restart=on-failure
RestartSec=5

# Sandbox. MemoryDenyWriteExecute stays off (the .NET JIT writes and executes code), and so does ~@resources
# (the runtime calls into it at start and is killed with SIGSYS).
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077

[Install]
WantedBy=multi-user.target
