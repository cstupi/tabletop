# One-shot: `Tabletop.Management --migrate` as the owner role. tabletop-management.service requires it, so every start of
# management applies pending migrations first, and a failed migration keeps management down.
[Unit]
Description=Tabletop database migrations
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
# TABLETOP_DB_CONNECTION as tabletop_owner. Mode 0600, owner root: systemd reads it before dropping privileges.
EnvironmentFile=/etc/tabletop/migrate.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_EnableDiagnostics=0
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
WorkingDirectory=/opt/tabletop/management
ExecStart=/usr/bin/dotnet /opt/tabletop/management/Tabletop.Management.dll --migrate

# Sandbox. MemoryDenyWriteExecute stays off (the .NET JIT writes and executes code), and so does ~@resources
# (the runtime calls into it at start and is killed with SIGSYS).
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077

[Install]
WantedBy=multi-user.target
