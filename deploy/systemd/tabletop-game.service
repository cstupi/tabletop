[Unit]
Description=Tabletop game server (127.0.0.1:5200, behind Caddy)
After=network-online.target postgresql.service tabletop-management.service
Wants=network-online.target

[Service]
Type=exec
# The runtime role's TABLETOP_DB_CONNECTION and the Stytch project. Mode 0600, owner root.
EnvironmentFile=/etc/tabletop/game.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_EnableDiagnostics=0
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=Kestrel__Endpoints__Http__Url=http://127.0.0.1:5200
WorkingDirectory=/opt/tabletop/game
ExecStart=/usr/bin/dotnet /opt/tabletop/game/Tabletop.GameServer.dll
Restart=on-failure
RestartSec=5
# Live sessions drain on SIGTERM; the server's own shutdown timeout is 30 s.
TimeoutStopSec=40

# Sandbox. MemoryDenyWriteExecute stays off (the .NET JIT writes and executes code), and so does ~@resources
# (the runtime calls into it at start and is killed with SIGSYS).
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077

[Install]
WantedBy=multi-user.target
