# Production settings for deploy/docker-compose.prod.yml (--env-file) or the systemd units (EnvironmentFile, split per
# service: deploy/systemd/README in deploy/README.md). Copy to /etc/tabletop/prod.env, owner root, mode 0600.
# Generate every secret with `openssl rand -hex 32`: connection strings take them verbatim, so keep to [0-9a-f].
# The servers refuse to start with the test Stytch URL, an http or loopback public origin, or a dev-stack credential.

# Public origins (https, as players reach them through Caddy)
TABLETOP_WEB_URL=https://tabletop.example.org
TABLETOP_S3_PUBLIC_ENDPOINT=https://blobs.tabletop.example.org

# Stytch live project
TABLETOP_STYTCH_BASE_URL=https://api.stytch.com
TABLETOP_STYTCH_PROJECT_ID=project-live-00000000-0000-0000-0000-000000000000
TABLETOP_STYTCH_SECRET=

# Postgres: the image's superuser, then the roles scripts/postgres/roles.sh creates
TABLETOP_PG_SUPERUSER_PASSWORD=
TABLETOP_DB_OWNER_PASSWORD=
TABLETOP_DB_MANAGEMENT_PASSWORD=
TABLETOP_DB_GAME_PASSWORD=

# Object store. With the `minio` profile: MinIO's root (used only by minio-init) and the bucket-scoped service user it creates.
# With S3 or R2 instead: TABLETOP_S3_ENDPOINT is the provider's endpoint, the keys are a token scoped to the bucket, and the
# MinIO lines are unused.
TABLETOP_S3_ENDPOINT=http://minio:9000
TABLETOP_S3_BUCKET=tabletop-blobs
TABLETOP_S3_ACCESS_KEY=tabletop-app-prod
TABLETOP_S3_SECRET_KEY=
TABLETOP_MINIO_ROOT_USER=tabletop-root
TABLETOP_MINIO_ROOT_PASSWORD=

# Image tag for the built server images
TABLETOP_VERSION=latest
