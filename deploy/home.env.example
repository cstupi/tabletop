# Home-server settings for deploy/docker-compose.home.yml (scripts/release --deploy home). Copy to
# /opt/docker/tabletop/home.env (or /etc/tabletop/home.env), owner root, mode 0600; home.env is never committed.
# Generate every secret with `openssl rand -hex 32`: connection strings take them verbatim, so keep to [0-9a-f].
# The servers refuse to start with the test Stytch URL, an http or loopback public origin, or a dev-stack credential.
# KEY=VALUE lines only, no inline comments: scripts/release reads the file as well as compose.

# Public origins, served by the owner's Caddy (deploy/README.md, Home server). No path, no trailing slash.
# APP host: web, /v1, /ws; also MinIO's CORS origin.
TABLETOP_WEB_URL=https://tabletop.cstupi.com
# FILES host: the address presigned URLs name; also the web build's CSP blob origin.
TABLETOP_S3_PUBLIC_ENDPOINT=https://files.tabletop.cstupi.com

# Stytch live project. The servers call the API at api.stytch.com. The custom auth domain login.tabletop.cstupi.com is a CNAME
# configured at Stytch, not served by this stack. Register https://tabletop.cstupi.com/reset-password as a RESET_PASSWORD
# redirect URL in the live project.
TABLETOP_STYTCH_BASE_URL=https://api.stytch.com
TABLETOP_STYTCH_PROJECT_ID=
TABLETOP_STYTCH_SECRET=

# Postgres (dedicated container, local named volume): the image's superuser, then the roles scripts/postgres/roles.sh creates
TABLETOP_PG_SUPERUSER_PASSWORD=
TABLETOP_DB_OWNER_PASSWORD=
TABLETOP_DB_MANAGEMENT_PASSWORD=
TABLETOP_DB_GAME_PASSWORD=

# MinIO: the root user (used only by minio-init) and the bucket-scoped service user the servers sign with
TABLETOP_S3_BUCKET=tabletop-blobs
TABLETOP_S3_ACCESS_KEY=tabletop-app-home
TABLETOP_S3_SECRET_KEY=
TABLETOP_MINIO_ROOT_USER=tabletop-root
TABLETOP_MINIO_ROOT_PASSWORD=

# The client-release publisher: minio-init creates it with Put on <bucket>/releases/* only. Leave the key empty to skip it.
# GitHub's release workflow uploads through the FILES host, so its RELEASE_S3_ENDPOINT secret is TABLETOP_S3_PUBLIC_ENDPOINT.
RELEASE_S3_ENDPOINT=https://files.tabletop.cstupi.com
RELEASE_S3_BUCKET=tabletop-blobs
RELEASE_S3_ACCESS_KEY=tabletop-release-home
RELEASE_S3_SECRET_KEY=

# Caddy's address as management sees it, for X-Forwarded-For: gateway_default's subnet, from
#   docker network inspect gateway_default -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# Commented out, scripts/release reads it at deploy time. Required when running docker compose by hand.
#TABLETOP_TRUSTED_PROXIES=172.18.0.0/16

# NAS paths (NFS, all_squash to 1025:100). MinIO and pg-backup run as that uid:gid.
TABLETOP_MINIO_DATA=/mnt/tabletop/minio
TABLETOP_PG_BACKUP_DIR=/mnt/tabletop/pg-backups
TABLETOP_NAS_UID=1025
TABLETOP_NAS_GID=100
TABLETOP_PG_BACKUP_KEEP=14
# HH:MM, UTC
TABLETOP_PG_BACKUP_AT=03:30

# The external network the owner's Caddy is on, and the container-name prefix Caddy's upstreams use
TABLETOP_GATEWAY_NETWORK=gateway_default
TABLETOP_CONTAINER_PREFIX=tabletop

# Image tag for the built images (scripts/release sets it to the release version)
TABLETOP_VERSION=latest
