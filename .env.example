# Local development only. Copy to .env; docker compose reads it, and both servers read it in Development only (from the
# working directory, never a parent). Production settings: deploy/prod.env.example.
TABLETOP_DB_PASSWORD=tabletop
TABLETOP_DB_CONNECTION=Host=localhost;Port=5432;Database=tabletop;Username=tabletop;Password=tabletop;Search Path=management,game,public
TABLETOP_S3_ENDPOINT=http://127.0.0.1:9000
TABLETOP_S3_BUCKET=tabletop-blobs
# The bucket-scoped service user compose's minio-init creates (scripts/minio/init.sh); MinIO's root user is
# TABLETOP_MINIO_ROOT_USER / TABLETOP_MINIO_ROOT_PASSWORD, default tabletop / tabletop-secret.
TABLETOP_S3_ACCESS_KEY=tabletop-app
TABLETOP_S3_SECRET_KEY=tabletop-app-secret
TABLETOP_MANAGEMENT_URL=http://127.0.0.1:5100
TABLETOP_WEB_URL=http://localhost:5173
TABLETOP_STYTCH_BASE_URL=https://test.stytch.com
TABLETOP_STYTCH_PROJECT_ID=project-test-7a0ad7e7-906a-434a-a3d2-bf90668f9f43
# The Stytch test project's secret; the compose management container reads it from here. ./scripts/management also accepts `dotnet user-secrets set STYTCH_SECRET <secret>` in server/management when this stays empty.
TABLETOP_STYTCH_SECRET=
# TABLETOP_STYTCH_JWKS_URL= (derived from TABLETOP_STYTCH_BASE_URL and the project id when unset)
