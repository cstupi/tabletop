# The web image's server (web/Dockerfile): static files, SPA fallback, response headers. TLS and the public hostname belong
# to the fronting reverse proxy; this listens on plain :8080 on the container network.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip
	header {
		# frame-ancestors cannot travel in the build's CSP <meta> tag; a second policy holding only this directive adds it.
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@mutable not path /_app/immutable/*
	header @mutable Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
