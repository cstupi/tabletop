<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Tabletop.Management</RootNamespace>
    <UserSecretsId>tabletop-management</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="dbup-postgresql" Version="6.1.5" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../libs/Tabletop.Content/Tabletop.Content.csproj" />
    <ProjectReference Include="../../libs/Tabletop.Protocol/Tabletop.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/*.sql" />
    <EmbeddedResource Include="Content/Armies/army-book-units.json" LogicalName="army-book-units.json" />
    <EmbeddedResource Include="../../client/content/builtin/catalog.json" LogicalName="builtin-catalog.json" Link="Content/Layouts/builtin-catalog.json" />
    <EmbeddedResource Include="../../client/content/builtin/tables/*.json" LogicalName="builtin-table-%(Filename).json" />
  </ItemGroup>
</Project>
